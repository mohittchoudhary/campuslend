# CampusLend Environment Configuration
# Target Campus: Uka Tarsadia University

APP_NAME="CampusLend"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
CAMPUS_NAME="Uka Tarsadia University"
CAMPUS_EMAIL_DOMAIN="utu.ac.in"

# Database Configuration (MySQL / MariaDB for XAMPP / WAMP)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=campuslend
DB_USERNAME=root
DB_PASSWORD=

# SQLite Fallback (Auto-switches if MySQL is unreachable or DB_CONNECTION=sqlite)
DB_SQLITE_PATH="../database/campuslend.sqlite"

# Mail Configuration (PHPMailer)
# Set MAIL_SIMULATION=false and fill SMTP credentials to send real campus emails
MAIL_SIMULATION=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=campuslend.utu@gmail.com
MAIL_PASSWORD=your_app_specific_password_here
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=campuslend@utu.ac.in
MAIL_FROM_NAME="CampusLend UTU"

# Python Smart Match Microservice
PYTHON_SERVICE_URL="http://127.0.0.1:5000"
PYTHON_SERVICE_TIMEOUT=2.0

# Session & Security
SESSION_LIFETIME=7200
CSRF_SECRET=campuslend_super_secure_random_csrf_secret_key_2026
